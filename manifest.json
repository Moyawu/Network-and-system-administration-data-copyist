{
  "manifest_version": 3,
  "name": "ALT Linux Sysadmin DE Modules",
  "version": "2.1",
  "description": "Stealth DE Tool",
  "permissions": ["storage", "clipboardRead"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": [
        "marked.min.js",
        "state.js",
        "keyboard.js",
        "parser.js",
        "ui.js",
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["modul_1.md", "modul_2.md"],
      "matches": ["<all_urls>"]
    }
  ]
}