{
  "manifest_version": 3,
  "name": "ALT Linux Sysadmin DE Modules",
  "version": "1.10-beta",
  "description": "Stealth DE Tool (Cross-Domain Sync & KVM Typer)",
  "permissions": ["storage", "clipboardRead"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["marked.min.js", "content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["modul_1.md", "modul_2.md"],
      "matches": ["<all_urls>"]
    }
  ]
}