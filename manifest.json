{
  "manifest_version": 3,
  "name": "ALT Linux Sysadmin DE Modules",
  "version": "1.4",
  "description": "Добавляет модули ДЭ в конец инструкции (с автоопределением команд)",
  "content_scripts": [
    {
      "matches": ["*://www.altlinux.org/*"],
      "js": ["marked.min.js", "content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["modul_1.md", "modul_2.md"],
      "matches": ["*://www.altlinux.org/*"]
    }
  ]
}
